# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_PASSWORD=<set-me>
POSTGRES_HOST_PORT=5434
POSTGRES_CONNECTION=Host=localhost;Port=5434;Database=tiletwin;Username=tiletwin;Password=<set-me>

# --- Backend ---
JWT__SigningKey=<generate-a-long-random-value>
LLM__Provider=                # "groq" or "anthropic"; empty = whichever key is set (Anthropic first)
GROQ_API_KEY=                 # Groq key (gsk_...); with LLM__Provider=groq
ANTHROPIC_API_KEY=            # empty (and no GROQ_API_KEY) = AI assistant shows "AI NOT CONFIGURED"
LLM__Model=                   # e.g. claude-opus-5-5 (Anthropic) or openai/gpt-oss-120b (Groq default)
EMBEDDINGS__Provider=         # empty = keyword search fallback
ML_SERVICE_URL=http://localhost:8001
DEV_SEED_USER_PASSWORD=       # dev users are only created if this is set AND environment is Development

# --- ML service ---
TILE_MODEL_PATH=              # empty = "MODEL NOT CONFIGURED"
